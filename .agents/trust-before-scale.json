{
  "$schema": "https://raw.githubusercontent.com/ezraaaa/trust-before-scale-kit/main/plugins/trust-before-scale/schema/config.schema.json",
  "level": 1,
  "_why_level": "Owner decision 19 Nov 2026: supervised first. Level 2+ needs a feature map (the kit has no screens); level 3 needs a kit eval suite after #13, #14, #16, #17, #21, #22.",
  "project": "trust-before-scale-kit",
  "baseBranch": "develop",
  "mergeGate": {
    "exitMarker": "EXIT=0",
    "requireMatchHead": true,
    "requireExitTest": true,
    "gateCommandPattern": "node\\s+scripts/gates\\.mjs"
  },
  "selfMerge": {
    "enabled": false,
    "_why_off": "Needs the owner's acceptance and level 4.",
    "requiredComments": [
      {
        "name": "Routine evidence",
        "pattern": "^## Routine evidence$"
      }
    ]
  },
  "learn": {},
  "autopilot": {
    "maxLanes": 1,
    "handoff": "HANDOFF.md",
    "continuation": "HANDOFF.md",
    "extension": ".claude/skills/autopilot/SKILL.md"
  },
  "routine": {
    "extension": "docs/trust-before-scale/routine-extension.md",
    "rows": [
      {
        "name": "generated",
        "paths": [
          "^dist/gemini/",
          "^scripts/tbs/",
          "^docs/trust-before-scale/brief-template\\.md$",
          "^\\.agents/plugins/marketplace\\.json$",
          "^\\.cursor-plugin/marketplace\\.json$",
          "^plugins/trust-before-scale/\\.(codex|cursor)-plugin/",
          "^plugins/trust-before-scale/hooks/(codex|cursor)\\.json$"
        ],
        "passes": [],
        "gates": true,
        "reason": "Generated by scripts/build-harness.mjs; the harness check proves they match their sources"
      },
      {
        "name": "prose-no-gate",
        "paths": [
          "^HANDOFF\\.md$",
          "^CHANGELOG\\.md$",
          "^README\\.md$",
          "^THIRD_PARTY_NOTICES\\.md$",
          "^LICENSE$",
          "^docs/recipes/",
          "^PLAN\\.md$"
        ],
        "passes": [],
        "reason": "Informational prose with no gate consumer"
      },
      {
        "name": "prose-consumed",
        "paths": [
          "^(AGENTS|GEMINI|CONTRIBUTING|SECURITY)\\.md$",
          "^\\.agents/",
          "^\\.claude/",
          "^\\.github/(ISSUE_TEMPLATE/|pull_request_template\\.md$)",
          "^docs/(maintaining|harnesses)\\.md$",
          "^docs/trust-before-scale/"
        ],
        "passes": [],
        "gates": true,
        "reason": "Instructions and config read by agents, hooks or gates; run the gates"
      },
      {
        "name": "shipped-skills",
        "paths": [
          "^plugins/trust-before-scale/(skills|rules|profiles|templates/docs|templates/ci)/"
        ],
        "passes": [
          "correctness",
          "deep-review",
          "cross-review"
        ],
        "gates": true,
        "reason": "Shipped instructions change behaviour in every adopting project"
      },
      {
        "name": "gate-code",
        "paths": [
          "^plugins/trust-before-scale/(templates/scripts|hooks|bin|schema|tests)/",
          "^scripts/[^/]+$",
          "^\\.github/workflows/"
        ],
        "passes": [
          "simplify",
          "correctness",
          "deep-review",
          "security",
          "edge-cases",
          "cross-review"
        ],
        "gates": true,
        "reason": "Gate, hook, installer and CI code: a wrong check passes bad work everywhere"
      },
      {
        "name": "plugin-manifest",
        "paths": [
          "^plugins/trust-before-scale/\\.claude-plugin/",
          "^\\.claude-plugin/",
          "^\\.gitignore$"
        ],
        "passes": [
          "correctness",
          "cross-review"
        ],
        "gates": true,
        "reason": "Manifests and ignore rules decide what ships and what is checked"
      }
    ],
    "passes": {
      "simplify": {
        "claude": "/simplify {range}",
        "codex": "Write task: simplify {range}; reuse and efficiency; no behaviour change",
        "cursor-agent": "Agent task: simplify {range}; no behaviour change",
        "gemini": "Agent task: simplify {range}; no behaviour change",
        "fallback": "kit simplify skill"
      },
      "correctness": {
        "claude": "/code-review {level}; range {range}",
        "codex": "codex review --base {base}",
        "cursor-agent": "Agent correctness review of {range} at {level}",
        "gemini": "Agent correctness review of {range} at {level}",
        "fallback": "kit code-review skill"
      },
      "security": {
        "claude": "/claude-security scan changes --base {base}, or /security-review; inspect the whole surface",
        "codex": "Agent task with security-review skill",
        "cursor-agent": "Agent task with security-review skill",
        "gemini": "Agent task with security-review skill",
        "fallback": "kit security-review skill"
      },
      "cross-review": {
        "claude": "codex review --base {base}; confirm model differs from author",
        "codex": "Claude /code-review {level}; range {range}; confirm model differs from author",
        "cursor-agent": "Other installed host: correctness review of {range}; confirm different model",
        "gemini": "Other installed host: correctness review of {range}; confirm different model",
        "fallback": "Record unavailable reason; run correctness one level higher"
      },
      "deep-review": {
        "claude": "Use deep-review skill on {range}",
        "codex": "Use deep-review skill on {range}",
        "cursor-agent": "Use deep-review skill on {range}",
        "gemini": "Use deep-review skill on {range}",
        "fallback": "kit deep-review skill"
      },
      "user-roles": {
        "claude": "Use user-roles skill on {range}",
        "codex": "Use user-roles skill on {range}",
        "cursor-agent": "Use user-roles skill on {range}",
        "gemini": "Use user-roles skill on {range}",
        "fallback": "kit user-roles skill"
      },
      "edge-cases": {
        "claude": "Use edge-cases skill on {range}",
        "codex": "Use edge-cases skill on {range}",
        "cursor-agent": "Use edge-cases skill on {range}",
        "gemini": "Use edge-cases skill on {range}",
        "fallback": "kit edge-cases skill"
      },
      "design-audit": {
        "claude": "Use design-audit skill on {range}",
        "codex": "Use design-audit skill on {range}",
        "cursor-agent": "Use design-audit skill on {range}",
        "gemini": "Use design-audit skill on {range}",
        "fallback": "kit design-audit skill"
      },
      "verify-walk": {
        "claude": "Use verify-walk skill on {range}",
        "codex": "Use verify-walk skill on {range}",
        "cursor-agent": "Use verify-walk skill on {range}",
        "gemini": "Use verify-walk skill on {range}",
        "fallback": "kit verify-walk skill"
      }
    },
    "ruleSources": [
      "AGENTS.md",
      "CONTRIBUTING.md",
      "SECURITY.md",
      "docs/maintaining.md",
      "docs/harnesses.md",
      "docs/trust-before-scale/enforcers.md"
    ],
    "designSystem": [],
    "personas": [],
    "coreFlows": [
      "docs/recipes/ci-only.md",
      "docs/recipes/learn-from-mistakes.md",
      "docs/recipes/mixed-tools.md",
      "docs/recipes/parallel-overnight.md",
      "docs/recipes/review-miss.md",
      "docs/recipes/routine-one-pr.md",
      "docs/recipes/solo-one-agent.md"
    ]
  }
}
